{
	"info": {
		"_postman_id": "massar-api-v1-collection",
		"name": "Massar API - Postman Collection",
		"description": "API Documentation and test requests for Massar API backend system.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register Center Admin (Pending Application)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"center_name\": \"Hope Medical Center\",\n  \"center_phone\": \"+201011112222\",\n  \"specialty\": \"Physical Therapy & Rehabilitation\",\n  \"country\": \"Egypt\",\n  \"city\": \"Cairo\",\n  \"therapists_count\": 5,\n  \"branches_count\": 2,\n  \"referral_source\": \"Facebook Ad\",\n  \"terms_accepted\": true,\n  \"name\": \"Dr. Tarek Admin\",\n  \"email\": \"tarek@hopemedical.com\",\n  \"phone\": \"+201011113333\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"register"
							]
						},
						"description": "Public endpoint for a Center Admin to register a new center. Creates pending Center and pending Admin User."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identity\": \"landlord@massar.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Authenticates user and returns Sanctum Bearer token. Saves token automatically to collection variable."
					},
					"response": []
				},
				{
					"name": "Get Auth User (Me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"me"
							]
						},
						"description": "Returns current authenticated user details and active center context."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"logout"
							]
						},
						"description": "Revokes current Sanctum access token."
					},
					"response": []
				}
			]
		},
		{
			"name": "Landlord - Subscriptions",
			"item": [
				{
					"name": "List Pending Center Applications",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/landlord/centers/pending",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"landlord",
								"centers",
								"pending"
							]
						},
						"description": "Retrieves paginated list of pending center applications requiring Landlord review."
					},
					"response": []
				},
				{
					"name": "Approve Center Application",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/landlord/centers/:center_id/approve",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"landlord",
								"centers",
								":center_id",
								"approve"
							],
							"variable": [
								{
									"key": "center_id",
									"value": "1",
									"description": "ID of the pending center to approve"
								}
							]
						},
						"description": "Approves center application, sets center to active, starts 14-day trial, and activates center admin user."
					},
					"response": []
				},
				{
					"name": "Reject Center Application",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Incomplete medical documentation.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/landlord/centers/:center_id/reject",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"landlord",
								"centers",
								":center_id",
								"reject"
							],
							"variable": [
								{
									"key": "center_id",
									"value": "1",
									"description": "ID of the pending center to reject"
								}
							]
						},
						"description": "Rejects center application, sets center to rejected, and deactivates center admin user."
					},
					"response": []
				}
			]
		}
	]
}
